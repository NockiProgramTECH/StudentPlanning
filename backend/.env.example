# Clé secrète OpenRouter (côté serveur FastAPI uniquement — JAMAIS dans Flutter ni Git)
OPENROUTER_API_KEY=sk-or-v1-remplacer-par-votre-cle
OPENROUTER_MODEL=openai/gpt-4o-mini

# Intégration Chariow (côté serveur FastAPI uniquement — JAMAIS dans Flutter ni Git)
# Clé API Chariow (Settings -> API Keys : sk_live_...)
CHARIOW_API_KEY=sk_live_remplacer_par_votre_cle_chariow
# Secret de signature Webhook Pulse Chariow (Pulses -> Signing secret : whsec_...)
CHARIOW_PULSE_SECRET=whsec_remplacer_par_votre_secret_pulse
# Optionnel : restreindre l'activation à un ID ou slug de produit Chariow précis (ex: prd_xyz789)
CHARIOW_PRODUCT_ID=
# URL de base de l'API Chariow (par défaut https://api.chariow.com/v1)
CHARIOW_BASE_URL=https://api.chariow.com/v1

# Optionnel : jetons d'accès pilotes locaux (`student_id:secret_token` séparés par des virgules)
STUDIA_ACCESS_TOKENS=etudiant_l2_sir_01:remplacer_par_jeton_secret_long

# Base SQLite serveur pour les supports de cours, licences Chariow et quotas IA
STUDIA_DB_PATH=studia_courses.sqlite3

# Quotas de sécurité par étudiant (protection budget OpenRouter)
STUDIA_MAX_DOCS_PER_DAY=5
STUDIA_MAX_QUIZ_REQUESTS_PER_DAY=20
STUDIA_MAX_TOKENS_PER_DAY=25000
STUDIA_MAX_COST_USD_PER_MONTH=1.50
STUDIA_INPUT_COST_PER_1M_USD=0.15
STUDIA_OUTPUT_COST_PER_1M_USD=0.60
